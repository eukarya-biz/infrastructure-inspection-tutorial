# Server
PORT=3000

# Re:Earth CMS connection
CMS_BASE_URL=https://api.cms.reearth.io/api/integrations
CMS_WORKSPACE_ID=your-workspace-id
CMS_PROJECT_ID=your-project-id

# CMS model keys
CMS_ASSETS_MODEL=assets
CMS_REPORTS_MODEL=reports

# Re:Earth CMS Integration token (keep secret — never commit the real value)
CMS_INTEGRATION_TOKEN=your-integration-token-here
